# ─────────────────────────────────────────────
# Munchingo WhatsApp Webhook — Environment Variables
# Copy this to .env and fill in the values
# ─────────────────────────────────────────────

# WhatsApp Cloud API — permanent system user token
WHATSAPP_TOKEN=your_permanent_system_user_token_here

# Phone Number ID (from Meta Developer Portal > WhatsApp > API Setup)
PHONE_NUMBER_ID=1245334191995122

# WhatsApp Business Account ID
WABA_ID=1934053140598084

# Product Catalog ID
CATALOG_ID=1592646269154053

# Webhook verify token — any secret string YOU choose
# Must match what you enter in Meta Developer Portal > Webhooks > Edit
VERIFY_TOKEN=munchingo_webhook_secret_2026

# Meta App Secret — verifies incoming WhatsApp webhook requests are genuinely
# from Meta (Meta Developer Portal > App Settings > Basic > App Secret).
# Without this set, incoming webhook POSTs are NOT signature-verified.
META_APP_SECRET=your_meta_app_secret_here

# ── Razorpay — payment links + webhook (utils/razorpay.js) ──
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── Supabase — order persistence (utils/database.js) ──
SUPABASE_URL=your_supabase_project_url_here
# Service role key, not anon -- RLS is enabled on `orders` with no public
# policies, so only the service role (bypasses RLS) can read/write it.
# Settings > API > Legacy anon, service_role API keys in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Resend — owner order-notification email (utils/mailer.js) ──
RESEND_API_KEY=your_resend_api_key_here
NOTIFY_EMAIL=owner_notification_email@example.com

# Owner's personal WhatsApp number (E.164, no +) — used to WhatsApp-notify the
# owner directly when a customer asks for a human (handlers/messageHandler.js
# sendHumanHandoff). Optional: if unset, owner is only notified by email.
OWNER_PHONE=your_own_whatsapp_number_here

# CORS allow-origin for the website's /api/checkout endpoint.
# Defaults to "*" (any origin) if unset — set this in production.
SITE_ORIGIN=https://munchingo.com

# Server port (Render sets this automatically; 3000 for local)
PORT=3000

# Shared secret protecting GET /internal/daily-digest (the daily packing-list
# email, triggered by .github/workflows/daily-digest.yml). Generate a random
# value and set the SAME value here (Render) and as a GitHub Actions repo
# secret named DIGEST_SECRET.
DIGEST_SECRET=your_random_digest_secret_here

# ── GST invoices + WhatsApp invoice (utils/invoice.js, utils/invoiceFlow.js) ──
# Run invoices_migration.sql in Supabase first. Without it invoices are skipped
# (everything else in the payment flow keeps working).
# Set once Meta approves the munchingo_invoice template (scripts/submit-invoice-template.js):
INVOICE_WA_TEMPLATE=
# Needed only to submit that template (Meta Developer Portal > App Settings > Basic > App ID)
META_APP_ID=

# ── Zoho Books sync (utils/zohoBooks.js) — leave blank to disable ──
ZOHO_DC=in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=60091499971
ZOHO_DEPOSIT_ACCOUNT_ID=4288800000000000456
ZOHO_GST_TAX_ID_5=4288800000000034214
ZOHO_IGST_TAX_ID_5=4288800000000034177
ZOHO_PAYMENT_MODE=others

# ── Launch gate + simplified notifications ──
# Orders are refused until this moment (default 15 Oct 2026, 1:00 PM IST). Change here if the launch moves.
ORDERS_OPEN_AT=2026-10-15T13:00:00+05:30
# Secret of YOUR choice. Open https://munchingo.com/checkout.html?preview=<this value> to place test orders before launch.
ORDER_PREVIEW_KEY=
# One email per paid order goes to NOTIFY_EMAIL. Set to off to rely on the 8:00 AM daily summary only.
OWNER_ORDER_ALERT=on
