# ─────────────────────────────────────────────
# Munchingo WhatsApp Webhook — Environment Variables
# Copy this to .env and fill in the values
# ─────────────────────────────────────────────

# WhatsApp Cloud API — permanent system user token
WHATSAPP_TOKEN=your_permanent_system_user_token_here

# Phone Number ID (from Meta Developer Portal > WhatsApp > API Setup)
PHONE_NUMBER_ID=1245334191995122

# WhatsApp Business Account ID
WABA_ID=1934053140598084

# Product Catalog ID
CATALOG_ID=1592646269154053

# Webhook verify token — any secret string YOU choose
# Must match what you enter in Meta Developer Portal > Webhooks > Edit
VERIFY_TOKEN=munchingo_webhook_secret_2026

# Server port (Render sets this automatically; 3000 for local)
PORT=3000
